{
  "name": "NicoChocoChipsWebNuxt",
  "version": "1.0.0",
  "description": "Nico ChocoChips web",
  "author": "Nicolás Montenegro",
  "private": true,
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.{css,scss}\" --allow-empty-input && node scripts/lint-sass.mjs",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --allow-empty-input --fix",
    "lint:style": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:style:fix": "stylelint \"**/*.{css,scss}\" --allow-empty-input --fix",
    "lint:sass": "node scripts/lint-sass.mjs",
    "dev": "cross-env NUXT_HOST=0.0.0.0 NUXT_PORT=3333 nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/prismic": "^3.0.6",
    "@pinia/nuxt": "^0.5.5",
    "@prismicio/client": "^7.9.0",
    "@vueuse/core": "^11.1.0",
    "bulma": "^0.9.4",
    "cross-env": "^7.0.3",
    "lottie-web": "^5.7.13",
    "nuxt": "^3.13.2",
    "pinia": "^2.2.4",
    "postscribe": "^2.0.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.6.1",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss-scss": "^4.0.9",
    "pug": "^3.0.2",
    "sass": "^1.79.5",
    "source-map": "^0.7.4",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,vue}": "eslint --fix",
    "*.{css,scss}": "stylelint",
    "*.{sass,vue}": "node scripts/lint-sass.mjs"
  }
}
