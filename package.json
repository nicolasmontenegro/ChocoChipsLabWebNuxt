{
  "name": "NicoChocoChipsWebNuxt",
  "version": "1.0.0",
  "description": "Nico ChocoChips web",
  "author": "Nicolás Montenegro",
  "private": true,
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.{css,scss}\" --allow-empty-input && node scripts/lint-sass.mjs",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --allow-empty-input --fix",
    "lint:style": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:style:fix": "stylelint \"**/*.{css,scss}\" --allow-empty-input --fix",
    "lint:sass": "node scripts/lint-sass.mjs",
    "dev": "cross-env NUXT_HOST=0.0.0.0 NUXT_PORT=3333 nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@nuxt/fonts": "^1.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/prismic": "^5.4.0",
    "@pinia/nuxt": "^1.0.3",
    "@prismicio/client": "^7.23.1",
    "@vueuse/core": "^15.0.0",
    "bulma": "^0.9.4",
    "cross-env": "^7.0.3",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "postscribe": "^2.0.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss-scss": "^4.0.9",
    "pug": "^3.0.4",
    "sass": "^1.108.2",
    "source-map": "^0.7.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,vue}": "eslint --fix",
    "*.{css,scss}": "stylelint",
    "*.{sass,vue}": "node scripts/lint-sass.mjs"
  }
}
